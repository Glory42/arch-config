#!/bin/bash
SYNC="${LID_SYNC:-$(dirname "$(readlink -f "$0")")/lid-sync}"
FLAG="${LID_FLAG:-${XDG_RUNTIME_DIR:-/tmp}/hypr-lid-docked}"
DELAYS="${LID_WATCH_DELAYS:-1 3 7}"
SOCKET="${LID_SOCKET:-$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock}"

exec 8>"${XDG_RUNTIME_DIR:-/tmp}/lid-watch.lock"
flock -n 8 || exit 0

events() {
    if command -v socat >/dev/null 2>&1; then
        socat -U - "UNIX-CONNECT:$SOCKET"
    else
        nc -U "$SOCKET"
    fi
}

retry_pid=""
sync_soon() {
    "$SYNC"
    [ -n "$retry_pid" ] && kill "$retry_pid" 2>/dev/null
    ( for delay in $DELAYS; do sleep "$delay"; "$SYNC"; done ) &
    retry_pid=$!
}

sync_soon
while true; do
    if read -r -t 2 event; then
        case "$event" in
            monitoradded\>\>*|monitorremoved\>\>*) sync_soon ;;
        esac
    elif [ $? -gt 128 ]; then
        [ -f "$FLAG" ] && "$SYNC"
    else
        break
    fi
done < <(events)
