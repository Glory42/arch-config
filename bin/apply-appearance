#!/bin/bash
set -e

FILE=~/.config/theme/appearance.json
get() { jq -r --arg k "$1" '.[$k] // empty' "$FILE"; }

cursor=$(get cursor_theme); size=$(get cursor_size)
font=$(get font); mono=$(get monospace_font)
gtk_theme=$(get gtk_theme); icon_base=$(get icon_base); icon=$(get icon_theme)

[ -d ~/.local/share/icons/"$icon" ] || icon=$icon_base

mkdir -p ~/.config/gtk-3.0 ~/.config/gtk-4.0 ~/.local/share/icons/default

cat > ~/.config/gtk-3.0/settings.ini <<EOT
# Generated by bin/apply-appearance from theme/appearance.json, do not edit
[Settings]
gtk-application-prefer-dark-theme=1
gtk-theme-name=$gtk_theme
gtk-icon-theme-name=$icon
gtk-font-name=$font
gtk-cursor-theme-name=$cursor
gtk-cursor-theme-size=$size
EOT

cat > ~/.config/gtk-4.0/settings.ini <<EOT
# Generated by bin/apply-appearance from theme/appearance.json, do not edit
[Settings]
gtk-application-prefer-dark-theme=1
gtk-icon-theme-name=$icon
gtk-font-name=$font
gtk-cursor-theme-name=$cursor
gtk-cursor-theme-size=$size
EOT

cat > ~/.local/share/icons/default/index.theme <<EOT
[Icon Theme]
Name=Default
Inherits=$cursor
EOT

if command -v gsettings >/dev/null 2>&1; then
    s=org.gnome.desktop.interface
    gsettings set $s cursor-theme "$cursor" 2>/dev/null || true
    gsettings set $s cursor-size "$size" 2>/dev/null || true
    gsettings set $s font-name "$font" 2>/dev/null || true
    gsettings set $s monospace-font-name "$mono" 2>/dev/null || true
    gsettings set $s gtk-theme "$gtk_theme" 2>/dev/null || true
    gsettings set $s icon-theme "$icon" 2>/dev/null || true
fi

if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] && command -v hyprctl >/dev/null 2>&1; then
    hyprctl setcursor "$cursor" "$size" >/dev/null 2>&1 || true
fi
