#!/bin/bash
# Recolours every app from the current palette: reads the colours once, then runs each piece in apply-theme.d in order
set -e
here=$(dirname "$(readlink -f "$0")")
PALETTE=~/.config/theme/palette.json
"$here/check-palette" "$PALETTE"

while read -r key value; do
    printf -v "$key" '%s' "${value:0:6}"
done < <(jq -r 'to_entries[] | select(.key | test("^(bg|fg|accent|border_active|border_inactive|regular[0-7]|bright[0-7]|comment|muted)$")) | "\(.key) \(.value)"' "$PALETTE")

mix() {
    local a=$1 b=$2 p=$3 out="" i x y
    for i in 0 2 4; do
        x=$((16#${a:i:2})); y=$((16#${b:i:2}))
        out+=$(printf '%02x' $(( (x * (100 - p) + y * p + 50) / 100 )))
    done
    echo "$out"
}
red=$regular1; green=$regular2; yellow=$regular3; blue=$regular4; magenta=$regular5; cyan=$regular6
dark_bg=$(mix "$bg" 000000 30)
lighter_bg=$(mix "$bg" "$fg" 8)
selection=$(mix "$bg" "$accent" 25)
edge=$(mix "$bg" "$fg" 18)
dim=$(mix "$fg" "$bg" 45)
dimmer=$(mix "$fg" "$bg" 70)

# Each piece sees the palette's colours by key name, the names and mixes above, mix and $here; one that fails is named and the rest still run
failed=()
for piece in "$here"/apply-theme.d/*.sh; do
    ( set +e; . "$piece" ) || failed+=("$(basename "$piece" .sh)")
done
if [ ${#failed[@]} -gt 0 ]; then
    echo "apply-theme: not applied: ${failed[*]}" >&2
    exit 1
fi
