[Unit]
Description=Apollo shell
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Qt's GTK theme opens a second Wayland connection that crashes Apollo when screens come and go fast; Apollo draws its own theme
UnsetEnvironment=QT_QPA_PLATFORMTHEME
ExecStart=/usr/bin/qs -n -p %h/.config/quickshell/shell.qml
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
