for dir in "$HOME/.local/bin" "$HOME/.local/share/mise/shims"; do
    case ":$PATH:" in *":$dir:"*) ;; *) PATH="$dir:$PATH" ;; esac
done
export PATH
unset dir

# Cursor theme and size come from theme/appearance.json (bin/apply-appearance writes them to GTK too)
appearance="$HOME/.config/theme/appearance.json"
export XCURSOR_THEME="$(jq -r '.cursor_theme // "Adwaita"' "$appearance" 2>/dev/null || echo Adwaita)"
export XCURSOR_SIZE="$(jq -r '.cursor_size // 24' "$appearance" 2>/dev/null || echo 24)"
export HYPRCURSOR_SIZE="$XCURSOR_SIZE"
unset appearance

# Wallpaper change animation: awww picks a random transition that lasts one second
export AWWW_TRANSITION=random
export AWWW_TRANSITION_DURATION=1
export AWWW_TRANSITION_FPS=60

# Force apps onto Wayland
export GDK_BACKEND="wayland,x11,*"
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME=gtk3
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export OZONE_PLATFORM=wayland
